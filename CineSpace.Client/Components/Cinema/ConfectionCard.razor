@namespace CineSpace.Client.Components.Cinema

<article class="confectionery-card @(abierta ? "is-expanded" : "")" style="--confectionery-row: @(Indice / 2 + 1); --confectionery-column: @(Indice % 2 + 1)" @onkeydown="Tecla">
    @if (abierta)
    {
        <div class="confectionery-inline-detail" id="@IdDetalle">
            <div class="confectionery-detail-heading"><img src="@Combo.Foto" alt="" /><button type="button" class="confectionery-close-detail" aria-label="Cerrar detalles de @Combo.Nombre" @ref="cerrar" @onclick="Cerrar"><i class="fas fa-xmark" aria-hidden="true"></i></button></div>
            <div class="confectionery-detail-copy"><span class="confectionery-detail-category">@Categoria</span><h2>@Combo.Nombre</h2><p class="confectionery-detail-description">@Combo.Descripcion</p></div>
            <div class="confectionery-detail-price"><strong>@(Combo.Precio > 0 ? $"{Combo.Precio:N2} Bs" : "Precio por definir")</strong><span>por unidad</span></div>
            @if (Cantidad > 0) { <p class="confectionery-detail-cart"><i class="fas fa-check" aria-hidden="true"></i>@Cantidad en tu carrito</p> }
            <div class="confectionery-pick-quantity"><span>Cantidad a añadir</span><div><button type="button" aria-label="Reducir unidades de @Combo.Nombre" disabled="@(Deshabilitada || seleccion <= 1)" @onclick="() => seleccion--"><i class="fas fa-minus" aria-hidden="true"></i></button><output aria-live="polite" aria-label="Unidades a añadir de @Combo.Nombre">@seleccion</output><button type="button" aria-label="Aumentar unidades de @Combo.Nombre" disabled="@(Deshabilitada || seleccion >= Maximo)" @onclick="() => seleccion++"><i class="fas fa-plus" aria-hidden="true"></i></button></div></div>
            <button type="button" class="btn btn-primary confectionery-detail-add" aria-label="Añadir @seleccion @(seleccion == 1 ? "unidad" : "unidades") de @Combo.Nombre al carrito" disabled="@NoDisponible" @onclick="() => OnAñadir.InvokeAsync((Combo, seleccion))"><i class="fas fa-plus" aria-hidden="true"></i>Añadir al carrito</button>
            @if (seleccion > 1) { <span class="confectionery-selection-total">Subtotal · @((Combo.Precio * seleccion).ToString("N2")) Bs</span> }
            @if (Cantidad >= 20) { <p class="confectionery-detail-cart">Ya tienes el máximo de 20 unidades.</p> }
        </div>
    }
    else
    {
        <button type="button" class="confectionery-photo" aria-label="Ver detalles de @Combo.Nombre" aria-expanded="false" aria-controls="@IdDetalle" @ref="disparador" @onclick="Abrir"><img src="@Combo.Foto" alt="" loading="lazy" decoding="async" width="768" height="768" /></button>
        @if (Cantidad > 0) { <span class="confectionery-in-cart"><i class="fas fa-check" aria-hidden="true"></i>@Cantidad en carrito</span> }
        <div class="confectionery-card-body"><h2><button type="button" @onclick="Abrir">@Combo.Nombre</button></h2><strong class="confectionery-card-price">@(Combo.Precio > 0 ? $"{Combo.Precio:N2} Bs" : "Precio por definir")</strong><button type="button" class="btn btn-primary confectionery-add" aria-label="Añadir @Combo.Nombre al carrito" disabled="@NoDisponible" @onclick="() => OnAñadir.InvokeAsync((Combo, 1))"><i class="fas fa-plus" aria-hidden="true"></i>Añadir</button></div>
    }
</article>
@code {
    [Parameter, EditorRequired] public ComboConfiteria Combo { get; set; } = null!;
    [Parameter] public string Categoria { get; set; } = "";
    [Parameter] public int Cantidad { get; set; }
    [Parameter] public bool Deshabilitada { get; set; }
    [Parameter] public int Indice { get; set; }
    [Parameter] public bool Abierta { get; set; }
    [Parameter] public EventCallback<bool> OnAbiertaChanged { get; set; }
    [Parameter] public EventCallback<(ComboConfiteria Combo, int Cantidad)> OnAñadir { get; set; }
    private int seleccion = 1;
    private int Maximo => Math.Max(1, 20 - Cantidad);
    private bool NoDisponible => Deshabilitada || Combo.Precio <= 0 || Cantidad >= 20;
    private bool abierta => Abierta;
    private bool enfocarDetalle, devolverFoco;
    private string IdDetalle => $"confection-detail-{Combo.Id}";
    private ElementReference disparador, cerrar;
    protected override void OnParametersSet() => seleccion = abierta ? Math.Clamp(seleccion, 1, Maximo) : 1;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (enfocarDetalle) { enfocarDetalle = false; await cerrar.FocusAsync(preventScroll: true); } if (devolverFoco) { devolverFoco = false; await disparador.FocusAsync(preventScroll: true); } }
    private async Task Abrir() { enfocarDetalle = true; await OnAbiertaChanged.InvokeAsync(true); }
    private async Task Cerrar() { devolverFoco = true; seleccion = 1; await OnAbiertaChanged.InvokeAsync(false); }
    private async Task Tecla(KeyboardEventArgs e) { if (e.Key == "Escape" && abierta) await Cerrar(); }
}
