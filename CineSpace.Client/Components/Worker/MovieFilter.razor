@namespace CineSpace.Client.Components.Worker
@using CineSpace.Shared.Models
@inject CatalogosService Catalogos

<div class="card mb-4">
    <div class="card-header bg-light">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-filter me-2"></i>Filtrar Películas
            </h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleCollapse">
                <i class="fas @(isCollapsed ? "fa-chevron-down" : "fa-chevron-up")"></i>
            </button>
        </div>
    </div>

    @if (!isCollapsed)
    {
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Género</label>
                    <select class="form-select" @bind="filtro.Genero">
                        <option value="Todas">Todas las películas</option>
                        @foreach (var genero in Catalogos.Generos.OrderBy(g => g.Nombre)) { <option value="@genero.Nombre">@genero.Nombre</option> }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Título</label>
                    <input type="text" class="form-control" placeholder="Buscar por título..."
                           @bind="filtro.Titulo" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Horario</label>
                    <select class="form-select" @bind="filtro.Horario">
                        <option value="">Todos los horarios</option>
                        @foreach (var horario in horarios)
                        {
                            <option value="@horario">@horario</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Ordenar por</label>
                    <select class="form-select" @bind="filtro.OrdenarPor">
                        <option value="titulo_asc">Título (A-Z)</option>
                        <option value="titulo_desc">Título (Z-A)</option>
                        <option value="genero">Género</option>
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-secondary" @onclick="LimpiarFiltros">
                    <i class="fas fa-times me-1"></i>Limpiar filtros
                </button>
                <button class="btn btn-primary" @onclick="AplicarFiltros">
                    <i class="fas fa-search me-1"></i>Aplicar filtros
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<PeliculaFiltro> OnFiltroAplicado { get; set; }

    private bool isCollapsed = false;
    private PeliculaFiltro filtro = new PeliculaFiltro();
    private List<string> horarios = new List<string> { "14:00", "15:30", "17:00", "18:30", "20:00", "21:30" };

    private void ToggleCollapse()
    {
        isCollapsed = !isCollapsed;
    }

    private async Task AplicarFiltros()
    {
        await OnFiltroAplicado.InvokeAsync(filtro);
    }

    private async Task LimpiarFiltros()
    {
        filtro = new PeliculaFiltro();
        await OnFiltroAplicado.InvokeAsync(filtro);
    }

    public class PeliculaFiltro
    {
        public string Genero { get; set; } = "Todas";
        public string Titulo { get; set; } = "";
        public string Horario { get; set; } = "";
        public string OrdenarPor { get; set; } = "titulo_asc";
    }
}
