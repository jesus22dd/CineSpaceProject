@namespace CineSpace.Client.Components.Worker

<div class="card mb-4">
    <div class="card-header @HeaderClass">
        <h5 class="mb-0">@Title</h5>
    </div>
    <div class="card-body">
        <p>@Message</p>

        @if (!string.IsNullOrEmpty(DetailMessage))
        {
            <p><strong>@DetailMessage</strong></p>
        }

        <div class="d-flex justify-content-between mt-4">
            <button class="btn btn-secondary" disabled="@ocupado" @onclick="HandleCancel">
                <i class="fas fa-times me-2"></i>@CancelText
            </button>
            <button class="btn @ConfirmButtonClass" disabled="@ocupado" aria-busy="@ocupado" @onclick="HandleConfirm">
                @if (ocupado) { <span class="button-spinner" aria-hidden="true"></span> } else { <i class="fas fa-check me-2"></i> }@ConfirmText
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Confirmar acción";

    [Parameter]
    public string Message { get; set; } = "¿Está seguro que desea realizar esta acción?";

    [Parameter]
    public string DetailMessage { get; set; } = "";

    [Parameter]
    public string ConfirmText { get; set; } = "Confirmar";

    [Parameter]
    public string CancelText { get; set; } = "Cancelar";

    [Parameter]
    public string HeaderClass { get; set; } = "bg-primary text-white";

    [Parameter]
    public string ConfirmButtonClass { get; set; } = "btn-primary";

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool ocupado;
    private async Task HandleConfirm()
    {
        if (ocupado) return; ocupado = true;
        try { await OnConfirm.InvokeAsync(); } finally { ocupado = false; }
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }
}