<div class="password-field">
    <label for="@Id">@Label</label>
    <div class="password-field-control">
        <input id="@Id" type="@(visible ? "text" : "password")" class="form-control" value="@Value" @oninput="Cambiar" @onblur="() => OnBlur.InvokeAsync()" required minlength="10" maxlength="128" autocomplete="new-password" spellcheck="false" aria-invalid="@(Invalid ? "true" : "false")" aria-describedby="@DescribedBy" @ref="input" />
        <button type="button" class="password-field-toggle" aria-label="@($"{(visible ? "Ocultar" : "Mostrar")} {Label.ToLowerInvariant()}")" aria-controls="@Id" aria-pressed="@(visible ? "true" : "false")" @onclick="() => visible = !visible"><i class="fas @(visible ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i></button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? DescribedBy { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public EventCallback OnBlur { get; set; }
    private bool visible;
    private ElementReference input;
    private Task Cambiar(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");
    public ValueTask FocusAsync() => input.FocusAsync();
}
