@page "/admin/proximos-estrenos"
@using System.Globalization
@using TMDBMovie = CineSpace.Shared.Models.TMDBMovie
@using CineSpace.Client.Components.Admin
@using CineSpace.Client.Components.Worker
@using CineSpace.Client.Components.Shared
@inject EstrenosService Estrenos
@inject CatalogosService Catalogos
@inject UsuarioService Usuarios
@inject PeliculaService Peliculas

<PageTitle>Próximos estrenos - CineSpace</PageTitle>
@if (!Usuarios.EsAdministrador())
{
    <div class="alert alert-danger" role="alert">Esta sección está disponible para administradores.</div>
}
else
{
    <div class="management-heading"><div><h1>Próximos estrenos</h1><p>Anuncia películas y abre la preventa cuando sus salas y horarios estén preparados.</p></div><div class="management-actions"><button type="button" class="btn btn-secondary" @onclick="NuevoDelCatalogo">Elegir del catálogo</button><button type="button" class="btn btn-primary" @onclick="() => buscando = true"><i class="fas fa-plus" aria-hidden="true"></i>Buscar en TMDB</button></div></div>
    @if (!string.IsNullOrEmpty(aviso)) { <div class="alert alert-success" role="status">@aviso</div> }
    @if (!string.IsNullOrEmpty(error) || Estrenos.ErrorCarga != null) { <div class="alert alert-danger" role="alert">@(Estrenos.ErrorCarga ?? error)</div> }
    @if (buscando)
    {
        <MovieSearch Titulo="Buscar próximo estreno" TextoVolver="Volver a próximos estrenos" OnPeliculaSeleccionada="Seleccionar" OnCancelar="() => buscando = false" />
    }
    else if (editando != null)
    {
        <UpcomingEditor @key="editando.Id" Valor="editando" Opciones="peliculas" Nuevo="nuevo" Ocupado="ocupado" OnGuardar="Guardar" OnCancelar="Cancelar" />
    }
    else
    {
        <div class="catalogue-toolbar"><form class="catalogue-search" role="search" @onsubmit="Buscar" @onsubmit:preventDefault><label for="upcoming-search" class="visually-hidden">Buscar próximo estreno</label><input id="upcoming-search" type="search" class="form-control" placeholder="Buscar película…" @bind="busqueda" @bind:event="oninput" /><button type="submit" class="btn btn-primary" aria-label="Buscar próximos estrenos"><i class="fas fa-search" aria-hidden="true"></i></button></form><div class="catalogue-secondary-filters"><select class="form-select" aria-label="Filtrar estado de estreno" value="@estado" @onchange="CambiarEstado"><option value="">Todos los estados</option><option value="anunciado">A estrenar</option><option value="preventa">Preventa disponible</option><option value="borrador">Borradores</option></select><CompactOrder Id="upcoming-order" Valor="@orden" ValorChanged="CambiarOrden" Opciones="Ordenes" /><ClearFiltersButton Activo="@(!string.IsNullOrWhiteSpace(filtro) || estado.Length > 0)" OnClear="Limpiar" /></div></div>
        <div class="managed-table-scroll"><table class="managed-movie-table upcoming-table"><thead><tr><th scope="col">Película</th><th scope="col">Género</th><th scope="col">Fecha de estreno</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead><tbody>
            @foreach (var p in Filtrados)
            {
                <tr @key="p.Id"><td><div class="managed-table-film"><img src="@PeliculaService.UrlImagen(p.ImagenUrl,"w92")" alt="Póster de @p.Titulo" loading="lazy" onerror="this.onerror=null;this.src='/images/poster-placeholder.svg';" /><strong>@p.Titulo</strong></div></td><td>@Catalogos.ResolverGenero(p.Genero)</td><td>@p.FechaEstreno.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("es-ES"))</td><td><span class="upcoming-state-label @(p.EnPreventa ? "is-presale" : "")">@(!p.Publicado ? "Borrador" : p.FechaEstreno <= DateOnly.FromDateTime(DateTime.Today) ? "En cartelera" : p.EnPreventa ? "Preventa disponible" : "A estrenar")</span>@if(p.PeliculaId.HasValue){<small class="upcoming-function-count">@p.FuncionesDisponibles funciones</small>}</td><td><div class="upcoming-row-actions"><button type="button" class="btn btn-secondary" aria-label="Editar @p.Titulo" @onclick="() => Editar(p)"><i class="fas fa-pen" aria-hidden="true"></i>Editar</button>@if(p.PeliculaId.HasValue){<a class="btn btn-secondary" aria-label="Programar funciones de @p.Titulo" href="@($"/admin/funciones?pelicula={p.PeliculaId}&estreno={p.FechaEstreno:yyyy-MM-dd}")"><i class="fas fa-calendar-days" aria-hidden="true"></i></a>}<button type="button" class="btn btn-secondary" aria-label="Eliminar @p.Titulo" @onclick="() => eliminar = p"><i class="fas fa-trash" aria-hidden="true"></i></button></div></td></tr>
            }
            @if (Filtrados.Count == 0) { <tr><td colspan="5" class="upcoming-empty">@(string.IsNullOrWhiteSpace(filtro) ? "Todavía no hay anuncios. Añade una película para presentarla en próximos estrenos." : "No hay estrenos que coincidan con la búsqueda.")</td></tr> }
        </tbody></table></div>
        <Pagination CurrentPage="pagina" TotalPages="@Math.Max(1, (int)Math.Ceiling(totalItems / 10d))" TotalItems="totalItems" PageSize="10" ShowPageSizeSelector="false" OnPageChanged="Paginar" Label="Paginación de próximos estrenos" />
    }
}
@if (eliminar != null)
{
    <AppDialog Title="Eliminar próximo estreno" OnClose="() => eliminar = null"><ChildContent><p>¿Quieres quitar el anuncio de <strong>@eliminar.Titulo</strong>?</p><p>Si tiene una preventa abierta, se cerrará. Las entradas ya compradas se conservarán.</p></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="() => eliminar = null">Cancelar</button><button type="button" class="btn btn-primary" disabled="@ocupado" @onclick="Eliminar">Eliminar anuncio</button></Footer></AppDialog>
}
@code {
    protected override async Task OnInitializedAsync() { if (Usuarios.EsAdministrador()) { try { peliculas = await Peliculas.OpcionesAsync(); await Cargar(); } catch(Exception ex) { error = ex.Message; } } }
    private async Task Paginar(int valor) { pagina = valor; await Cargar(); }
    private async Task Cargar() { var p = await Estrenos.ConsultarAsync(new() { Pagina = pagina, Tamano = 10, Buscar = filtro, Estado = estado, Orden = orden == "Más lejanos" ? "recientes" : orden == "Nombre de película" ? "nombre" : "antiguas" }); Filtrados = p.Items; totalItems = p.Total; pagina = p.Numero; }

    private bool buscando, nuevo, ocupado;
    private ProximoEstreno? editando, eliminar;
    private string busqueda = "", filtro = "", estado = "", orden = "Más próximos", error = "", aviso = "";
    private List<Pelicula> peliculas = [];
    private static readonly string[] Ordenes = { "Más próximos", "Más lejanos", "Nombre de película" };
    private int pagina = 1;
    private List<ProximoEstreno> Filtrados = [];
    private int totalItems;
    private async Task Reiniciar() { pagina = 1; await Cargar(); }
    private async Task Buscar() { filtro = busqueda.Trim(); await Reiniciar(); }
    private async Task Limpiar() { busqueda = filtro = estado = ""; await Reiniciar(); }
    private async Task CambiarEstado(ChangeEventArgs e) { estado = e.Value?.ToString() ?? ""; await Reiniciar(); }
    private async Task CambiarOrden(string valor) { orden = valor; await Reiniciar(); }
    private void Seleccionar(TMDBMovie movie)
    {
        var vinculada = peliculas.FirstOrDefault(p => p.TmdbId == movie.id);
        var existente = Estrenos.Todos.FirstOrDefault(p => vinculada != null && p.PeliculaId == vinculada.Id);
        if (existente != null) { Editar(existente); buscando = false; return; }
        if (string.IsNullOrWhiteSpace(movie.poster_path)) { error = "Esta película no tiene póster disponible. Elige otra película."; return; }
        var lanzamiento = DateTime.TryParseExact(movie.release_date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var dia) && dia >= DateTime.Today ? dia : DateTime.Today.AddDays(7);
        editando = new(0, movie.title ?? "", vinculada?.ImagenUrl ?? movie.poster_path, PeliculaService.GeneroEstreno(movie.genre_ids?.FirstOrDefault() ?? 0), DateOnly.FromDateTime(lanzamiento), movie.overview ?? "", PeliculaId: vinculada?.Id);
        nuevo = true; error = aviso = ""; buscando = false;
    }
    private void Editar(ProximoEstreno estreno) { editando = estreno; nuevo = false; error = aviso = ""; }
    private void NuevoDelCatalogo() { editando = new(0,"","","Drama",DateOnly.FromDateTime(DateTime.Today.AddDays(7))); nuevo = true; buscando = false; error = aviso = ""; }
    private void Cancelar() { editando = null; error = ""; }
    private async Task Guardar(ProximoEstreno solicitud)
    {
        if (editando == null || ocupado) return;
        ocupado = true; error = "";
        try { await Estrenos.GuardarAsync(solicitud, nuevo); editando = null; aviso = solicitud.EnPreventa ? "Preventa abierta. Las funciones ya pueden reservarse." : "Estreno guardado. La preventa está cerrada."; await Reiniciar(); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException) { error = ex.Message; } catch { error = "No pudimos guardar el estreno. Inténtalo de nuevo."; } finally { ocupado = false; }
    }
    private async Task Eliminar() { if (eliminar == null || ocupado) return; ocupado = true; try { await Estrenos.EliminarAsync(eliminar.Id); eliminar = null; aviso = "Anuncio eliminado."; await Reiniciar(); } catch { error = "No pudimos eliminar el anuncio. Inténtalo de nuevo."; } finally { ocupado = false; } }
}
