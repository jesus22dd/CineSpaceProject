@inject ApiCine Api
@page "/admin/distribuidoras"
@using CineSpace.Client.Components.Admin
@using CineSpace.Client.Components.Shared
@inject CatalogosService Catalogos
@inject PeliculaService Peliculas
@inject UsuarioService Usuarios
<PageTitle>Distribuidoras - CineSpace</PageTitle>
@if (!Usuarios.EsAdministrador()) { <div class="alert alert-danger" role="alert">Esta sección está disponible para administradores.</div> }
else
{
    <div class="movie-management">
    <div class="management-heading"><div><h1>Distribuidoras</h1><p>Gestiona las distribuidoras y asígnalas a las películas.</p></div><button type="button" class="btn btn-primary" disabled="@(Catalogos.ErrorCarga != null)" @onclick="Crear"><i class="fas fa-plus" aria-hidden="true"></i>Crear distribuidora</button></div>
    @if (!string.IsNullOrEmpty(aviso)) { <div class="alert alert-success" role="status">@aviso</div> }
    @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (!string.IsNullOrEmpty(Catalogos.ErrorCarga)) { <div class="alert alert-warning" role="alert">@Catalogos.ErrorCarga</div> }
    @if (editor != null)
    {
        <form class="experience-editor distributor-editor" @onsubmit="Guardar" @onsubmit:preventDefault aria-label="Editar distribuidora"><div><label for="distributor-name">Nombre</label><input id="distributor-name" class="form-control" maxlength="60" required @bind="editor.Nombre" @bind:event="oninput" @ref="nombreInput" /></div><div><label for="distributor-description">Contacto</label><input id="distributor-description" class="form-control" maxlength="120" placeholder="Nombre de la persona de contacto" @bind="editor.Contacto" @bind:event="oninput" /></div><div><label for="distributor-email">Correo</label><input id="distributor-email" class="form-control" type="email" maxlength="254" @bind="editor.Email" @bind:event="oninput" /></div><div><label for="distributor-phone">Teléfono</label><input id="distributor-phone" class="form-control" type="tel" maxlength="32" @bind="editor.Telefono" @bind:event="oninput" /></div><div class="experience-editor-actions"><button type="button" class="btn btn-secondary" @onclick="Cancelar" disabled="@guardando">Cancelar</button><button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando…" : "Guardar")</button></div></form>
    }
    <div class="catalogue-toolbar movie-management-toolbar"><form class="catalogue-search @(busqueda.Length > 0 || filtro.Length > 0 ? "has-query" : "")" role="search" @onsubmit="Buscar" @onsubmit:preventDefault><label class="visually-hidden" for="distributor-search">Buscar distribuidora</label><input id="distributor-search" class="form-control" type="search" placeholder="Buscar distribuidora…" @bind="busqueda" @bind:event="oninput" />@if (busqueda.Length > 0 || filtro.Length > 0) { <button type="button" class="catalogue-clear" aria-label="Limpiar búsqueda" @onclick="Limpiar"><i class="fas fa-times" aria-hidden="true"></i></button> }<button type="submit" class="btn btn-primary" aria-label="Buscar distribuidoras"><i class="fas fa-search" aria-hidden="true"></i></button></form><div class="catalogue-secondary-filters"><CompactOrder Id="distributor-order" Valor="@orden" ValorChanged="CambiarOrden" /><ClearFiltersButton Activo="@(!string.IsNullOrEmpty(filtro))" OnClear="Limpiar" /></div></div>
    @if (Filtradas.Count == 0) { <div class="catalogue-empty" role="status"><h2>No hay distribuidoras que mostrar</h2><p>Crea una distribuidora o prueba otra búsqueda.</p></div> }
    else
    {
        <ManagementTable Title="Distribuidoras" Summary="@($"{Filtradas.Count} distribuidoras")" TableClass="experience-table distributor-table"><HeaderContent><tr><th scope="col">Distribuidora</th><th scope="col">Contacto</th><th scope="col">Correo</th><th scope="col">Teléfono</th><th scope="col">Películas</th><th scope="col">Acciones</th></tr></HeaderContent><ChildContent>@foreach (var e in Filtradas) { <tr data-distributor="@e.Id"><td><strong>@e.Nombre</strong></td><td><p class="catalogue-description" title="@e.Contacto">@(string.IsNullOrWhiteSpace(e.Contacto) ? "—" : e.Contacto)</p></td><td>@(e.Email.Length > 0 ? e.Email : "—")</td><td>@(e.Telefono.Length > 0 ? e.Telefono : "—")</td><td>@Uso(e.Id)</td><td><div class="managed-table-actions"><button type="button" class="btn btn-secondary" aria-label="Editar @e.Nombre" @onclick="() => Editar(e)"><i class="fas fa-pen-to-square" aria-hidden="true"></i></button><button type="button" class="btn btn-danger" aria-label="Eliminar @e.Nombre" title="@(Uso(e.Id) > 0 ? "Asignada a películas" : "Eliminar")" disabled="@(Uso(e.Id) > 0)" @onclick="() => eliminar = e"><i class="fas fa-trash" aria-hidden="true"></i></button></div></td></tr> }</ChildContent></ManagementTable>
        <Pagination CurrentPage="pagina" TotalPages="TotalPaginas" TotalItems="totalItems" PageSize="PorPagina" ShowPageSizeSelector="false" Label="Paginación de distribuidoras" OnPageChanged="CambiarPaginaRemota" />
    }
    </div>
}
@if (eliminar != null) { <AppDialog Title="¿Eliminar esta distribuidora?" OnClose="() => eliminar = null" @ref="dialogo"><ChildContent><p>Se eliminará <strong>@eliminar.Nombre</strong> del catálogo. Esta acción no se puede deshacer.</p></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button><button type="button" class="btn btn-danger" @onclick="Eliminar" disabled="@guardando">Eliminar</button></Footer></AppDialog> }
@code {
    private async Task CambiarPaginaRemota(int valor) { pagina = valor; await CargarPagina(); }
    private async Task CargarPagina() {
        try {
            var f = new ConsultaPagina { Pagina = pagina, Tamano = PorPagina, Buscar = filtro, Orden = orden == "Más recientes" ? "recientes" : "antiguas" };
            var page = await Catalogos.ConsultarDistribuidorasAsync(f);
            Filtradas = page.Items; totalItems = page.Total; pagina = page.Numero;
        } catch (Exception ex) { error = ex.Message; }
    }

    private List<Pelicula> peliculas = new();
    protected override async Task OnInitializedAsync() { if (Usuarios.EsAdministrador()) await CargarPagina(); }
    private const int PorPagina = 8;
    private int pagina = 1;
    private string busqueda = "", filtro = "", orden = "Más recientes", aviso = "", error = "";
    private bool guardando, enfocar;
    private Distribuidora? editor, eliminar;
    private AppDialog? dialogo;
    private ElementReference nombreInput;
    private int Uso(int id) => Api.Referencias.UsosDistribuidoras.GetValueOrDefault(id);
    private List<Distribuidora> Filtradas = [];
    private int totalItems;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(totalItems / (double)PorPagina));
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (enfocar && editor != null) { enfocar = false; await nombreInput.FocusAsync(); } }
    private void Cancelar() { editor = null; error = ""; }
    private void Crear() { editor = new() { Id = 0 }; enfocar = true; error = aviso = ""; }
    private void Editar(Distribuidora e) { editor = e.Copiar(); enfocar = true; error = aviso = ""; }
    private async Task Guardar() { if (editor == null || guardando) return; guardando = true; error = ""; try { var id = await Catalogos.GuardarDistribuidoraAsync(editor); aviso = $"{editor.Nombre.Trim()} guardada."; editor = null; busqueda = filtro = ""; pagina = 1; await CargarPagina(); } catch (ArgumentException ex) { error = ex.Message; } catch { error = "No pudimos guardar la distribuidora. Tus cambios siguen aquí."; } finally { guardando = false; } }
    private Task Cerrar() => dialogo?.CerrarDialogo() ?? Task.CompletedTask;
    private async Task Eliminar() { if (eliminar == null || guardando) return; guardando = true; try { await Catalogos.EliminarDistribuidoraAsync(eliminar.Id); await Cerrar(); await CargarPagina(); aviso = "Distribuidora eliminada."; } catch (ArgumentException ex) { await Cerrar(); error = ex.Message; } catch { await Cerrar(); error = "No pudimos eliminar la distribuidora."; } finally { guardando = false; } }
    private async Task Buscar() { filtro = busqueda.Trim(); pagina = 1;  await CargarPagina(); }
    private async Task Limpiar() { busqueda = filtro = ""; pagina = 1;  await CargarPagina(); }
    private async Task CambiarOrden(string valor) { orden = valor; pagina = 1;  await CargarPagina(); }
}
