@page "/admin/confiteria"
@using CineSpace.Client.Components.Admin
@using CineSpace.Client.Components.Shared
@inject CatalogosService Catalogos
@inject UsuarioService Usuarios

<PageTitle>Gestión de confitería - CineSpace</PageTitle>
@if (!Usuarios.EsAdministrador()) { <div class="alert alert-danger" role="alert">La gestión de confitería está disponible para administradores.</div> }
else
{
    <div class="movie-management">
    <div class="management-heading"><div><h1>@(editor == null ? "Confitería" : editor.Id == 0 ? "Crear combo" : "Editar combo")</h1><p>@(editor == null ? "Gestiona los combos, sus fotos y lo que se muestra al público." : "Añade una foto y describe qué incluye el combo.")</p></div>@if (editor == null) { <button type="button" class="btn btn-primary" @onclick="Crear"><i class="fas fa-plus" aria-hidden="true"></i>Crear combo</button> }</div>
    @if (editor != null) { <ConfectionForm @key="version" Combo="editor" OnGuardar="Guardado" OnCancelar="() => editor = null" /> }
    else
    {
        @if (Catalogos.Combos.Any(c => c.Publicado && c.Precio == 0)) { <div class="alert alert-info" role="status">Define el precio de los combos publicados para habilitar su compra en la confitería.</div> }
        @if (!string.IsNullOrEmpty(aviso)) { <div class="alert alert-success" role="status">@aviso</div> }
        @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger" role="alert">@error</div> }
        @if (!string.IsNullOrEmpty(Catalogos.ErrorCarga)) { <div class="alert alert-warning" role="alert">@Catalogos.ErrorCarga</div> }
        <div class="catalogue-toolbar movie-management-toolbar"><form class="catalogue-search @(busqueda.Length > 0 || filtro.Length > 0 ? "has-query" : "")" role="search" @onsubmit="Buscar" @onsubmit:preventDefault><label class="visually-hidden" for="combo-search">Buscar combo</label><input id="combo-search" class="form-control" type="search" placeholder="Buscar combo…" @bind="busqueda" @bind:event="oninput" />@if (busqueda.Length > 0 || filtro.Length > 0) { <button type="button" class="catalogue-clear" aria-label="Limpiar búsqueda" @onclick="Limpiar"><i class="fas fa-times" aria-hidden="true"></i></button> }<button type="submit" class="btn btn-primary" aria-label="Buscar combos"><i class="fas fa-search" aria-hidden="true"></i></button></form><div class="catalogue-secondary-filters"><AdminSelect Id="combo-category-filter" Etiqueta="Categoría" Valor="@categoria.ToString()" Opciones="OpcionesCategorias" Activo="@(categoria != 0)" ValorChanged="async valor => { categoria = int.Parse(valor); await Reiniciar(); }" /><CompactOrder Id="combo-order" Valor="@orden" ValorChanged="CambiarOrden" /><ClearFiltersButton Activo="@(!string.IsNullOrWhiteSpace(filtro) || categoria != 0)" OnClear="Limpiar" /></div></div>
        @if (Filtrados.Count == 0) { <div class="catalogue-empty" role="status"><i class="fas fa-cookie-bite" aria-hidden="true"></i><h2>@(Catalogos.Combos.Count == 0 ? "La confitería empieza con tu primer combo" : "No encontramos combos con esos filtros")</h2><p>@(Catalogos.Combos.Count == 0 ? "Crea un combo con foto, nombre, descripción y categoría para mostrarlo al público." : "Prueba otro nombre o selecciona todas las categorías.")</p></div> }
        else
        {
            <ManagementTable Title="Combos de confitería" Summary="@($"{Filtrados.Count} combos")" TableClass="confection-table"><HeaderContent><tr><th scope="col">Combo</th><th scope="col">Descripción</th><th scope="col">Categoría</th><th scope="col">Precio</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></HeaderContent><ChildContent>
                @foreach (var combo in Filtrados)
                {
                    <tr @key="combo.Id" data-combo-id="@combo.Id"><td><div class="catalogue-product-name"><img src="@combo.Foto" alt="" /><strong>@combo.Nombre</strong></div></td><td><p class="catalogue-description" title="@combo.Descripcion">@combo.Descripcion</p></td><td>@Catalogos.CategoriaNombre(combo.CategoriaId)</td><td class="order-table-amount">@(combo.Precio > 0 ? $"{combo.Precio:N2} Bs" : "Sin precio")</td><td>@(combo.Publicado ? "Publicado" : "Borrador")</td><td><div class="managed-table-actions"><button type="button" class="btn btn-secondary" aria-label="Editar @combo.Nombre" title="Editar" @onclick="() => Editar(combo)"><i class="fas fa-pen-to-square" aria-hidden="true"></i></button><button type="button" class="btn btn-danger" aria-label="Eliminar @combo.Nombre" title="Eliminar" @onclick="() => eliminar = combo"><i class="fas fa-trash" aria-hidden="true"></i></button></div></td></tr>
                }
            </ChildContent></ManagementTable>
            <Pagination CurrentPage="pagina" TotalPages="TotalPaginas" TotalItems="totalItems" PageSize="PorPagina" ShowPageSizeSelector="false" Label="Paginación de combos" OnPageChanged="CambiarPaginaRemota" />
        }
    }
    </div>
}
@if (eliminar != null)
{
    <AppDialog Title="¿Eliminar este combo?" OnClose="() => eliminar = null" @ref="confirmacion"><ChildContent><p>Se eliminará <strong>@eliminar.Nombre</strong> y su foto. Dejará de aparecer en la confitería.</p></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="CancelarEliminar" disabled="@borrando">Cancelar</button><button type="button" class="btn btn-danger" @onclick="Eliminar" disabled="@borrando">Eliminar combo</button></Footer></AppDialog>
}
@code {
    private async Task CambiarPaginaRemota(int valor) { pagina = valor; await CargarPagina(); }
    private async Task CargarPagina() {
        try {
            var f = new ConsultaPagina { Pagina = pagina, Tamano = PorPagina, Buscar = filtro, Categoria = categoria == 0 ? null : categoria, Orden = orden == "Más recientes" ? "recientes" : "antiguas" };
            var page = await Catalogos.ConsultarCombosAsync(f);
            Filtrados = page.Items; totalItems = page.Total; pagina = page.Numero;
        } catch (Exception ex) { error = ex.Message; }
    }

    protected override async Task OnInitializedAsync() { if (Usuarios.EsAdministrador()) await CargarPagina(); }
    private const int PorPagina = 8;
    private int pagina = 1, categoria;
    private string busqueda = "", filtro = "", orden = "Más recientes", aviso = "", error = "";
    private ComboConfiteria? editor, eliminar;
    private Guid version = Guid.NewGuid();
    private AppDialog? confirmacion;
    private bool borrando;
    private List<ComboConfiteria> Filtrados = [];
    private int totalItems;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(totalItems / (double)PorPagina));
    private void Crear() { editor = new(); version = Guid.NewGuid(); aviso = error = ""; }
    private void Editar(ComboConfiteria combo) { editor = combo.Copiar(); version = Guid.NewGuid(); aviso = error = ""; }
    private async Task Guardado(int id) { editor = null; busqueda = filtro = ""; categoria = 0; pagina = 1; await CargarPagina(); aviso = "Combo guardado correctamente.";  await CargarPagina(); }
    private Task CancelarEliminar() => confirmacion?.CerrarDialogo() ?? Task.CompletedTask;
    private async Task Eliminar() { if (eliminar == null || borrando) return; borrando = true; var combo = eliminar; try { await Catalogos.EliminarComboAsync(combo.Id); await CancelarEliminar(); aviso = $"{combo.Nombre} eliminado."; await CargarPagina(); } catch { await CancelarEliminar(); error = "No pudimos eliminar el combo. Inténtalo de nuevo."; } finally { borrando = false; } }
    private async Task Buscar() { filtro = busqueda.Trim(); pagina = 1;  await CargarPagina(); }
    private async Task Limpiar() { busqueda = filtro = ""; categoria = 0; pagina = 1;  await CargarPagina(); }
    private IReadOnlyList<AdminSelectOption> OpcionesCategorias => new[] { new AdminSelectOption("0", "Todas las categorías") }.Concat(Catalogos.Categorias.OrderBy(c => c.Nombre).Select(c => new AdminSelectOption(c.Id.ToString(), c.Nombre))).ToList();
    private async Task Reiniciar() { pagina = 1; await CargarPagina(); }
    private async Task CambiarOrden(string valor) { orden = valor; pagina = 1;  await CargarPagina(); }
}

