@page "/recuperar-clave"
@page "/restablecer-clave"
@page "/confirmar-cuenta"
@using System.ComponentModel.DataAnnotations
@using CineSpace.Client.Components.Auth
@inject ApiCine Api
@inject NavigationManager Navigation
@inject AuthDialogService Auth

<PageTitle>@Titulo — CineSpace</PageTitle>
<div class="email-access-page">
    <a href="/" class="email-access-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Volver a CineSpace</a>
    <section class="email-access" aria-labelledby="email-access-title" aria-busy="@ocupado">
        <header class="email-access-heading">
            <span class="email-access-symbol @(Exito ? "is-success" : "")" aria-hidden="true"><i class="@Icono"></i></span>
            <p class="email-access-eyebrow">Tu cuenta CineSpace</p>
            <h1 id="email-access-title" tabindex="-1" @ref="tituloElemento">@Titulo</h1>
            <p class="email-access-intro">@Descripcion</p>
        </header>

        @if (mensajeError.Length > 0)
        {
            <div class="email-access-error" role="alert" tabindex="-1" @ref="errorElemento"><i class="fas fa-exclamation-circle" aria-hidden="true"></i><p>@mensajeError</p></div>
        }

        @if (Ruta == "confirmar-cuenta")
        {
            @if (ocupado) { <p class="email-access-progress" role="status"><span class="button-spinner" aria-hidden="true"></span>Confirmando tu correo…</p> }
            else if (confirmada) { <button type="button" class="btn btn-primary email-access-submit" @onclick="Iniciar">Iniciar sesión<i class="fas fa-arrow-right" aria-hidden="true"></i></button> }
            else { <a class="btn btn-primary email-access-submit" href="/login">Volver al acceso</a> }
        }
        else if (Ruta == "restablecer-clave" && !EnlaceValido && !confirmada)
        {
            <a class="btn btn-primary email-access-submit" href="/recuperar-clave">Solicitar un nuevo enlace</a>
        }
        else if (confirmada)
        {
            <div class="email-access-state" role="status"><p>Tu contraseña se guardó correctamente. Inicia sesión con tu nueva contraseña para continuar.</p></div>
            <button type="button" class="btn btn-primary email-access-submit" @onclick="Iniciar">Iniciar sesión<i class="fas fa-arrow-right" aria-hidden="true"></i></button>
        }
        else if (correoEnviado)
        {
            <div class="email-access-state" role="status">
                <p>Si hay una cuenta asociada a <strong>@correoEnviadoA</strong>, recibirás un enlace para restablecer tu contraseña.</p>
                <p class="email-access-hint">¿No lo encuentras? Revisa la carpeta de spam o correo no deseado.</p>
            </div>
            <button type="button" class="btn btn-secondary email-access-submit" @onclick="UsarOtroCorreo">Usar otro correo</button>
        }
        else if (Ruta == "restablecer-clave")
        {
            <div class="email-access-account"><i class="far fa-envelope" aria-hidden="true"></i><span>@correo</span></div>
            <form class="email-access-form" @onsubmit="Restablecer" @onsubmit:preventDefault novalidate>
                <fieldset disabled="@ocupado">
                    <AuthPasswordField Id="reset-password" Label="Nueva contraseña" @bind-Value="password" DescribedBy="password-rules" Invalid="@(intentoEnvio && !PasswordValida)" @ref="passwordCampo" />
                    <ul class="email-access-rules" id="password-rules" aria-label="Requisitos de la contraseña">
                        <li class="@(TieneLongitud ? "is-met" : "")"><i class="fas @(TieneLongitud ? "fa-check-circle" : "fa-circle")" aria-hidden="true"></i><span><span class="visually-hidden">@(TieneLongitud ? "Cumplido: " : "Pendiente: ")</span>Al menos 10 caracteres</span></li>
                        <li class="@(TieneFormato ? "is-met" : "")"><i class="fas @(TieneFormato ? "fa-check-circle" : "fa-circle")" aria-hidden="true"></i><span><span class="visually-hidden">@(TieneFormato ? "Cumplido: " : "Pendiente: ")</span>Mayúscula, minúscula, número y símbolo</span></li>
                    </ul>
                    @if (intentoEnvio && !PasswordValida) { <p class="email-access-field-error" role="alert">Completa los requisitos de la nueva contraseña para continuar.</p> }
                    <AuthPasswordField Id="reset-password-confirm" Label="Confirmar nueva contraseña" @bind-Value="repetir" DescribedBy="@(MostrarErrorConfirmacion ? "password-match-error" : null)" Invalid="@MostrarErrorConfirmacion" OnBlur="() => confirmarTocada = true" @ref="confirmacionCampo" />
                    @if (MostrarErrorConfirmacion) { <p class="email-access-field-error" id="password-match-error" role="alert">Las contraseñas no coinciden. Revisa la confirmación.</p> }
                    <button type="submit" class="btn btn-primary email-access-submit" disabled="@ocupado">@if (ocupado) { <span class="button-spinner" aria-hidden="true"></span> }@(ocupado ? "Guardando contraseña…" : "Guardar nueva contraseña")</button>
                </fieldset>
            </form>
            <a href="/recuperar-clave" class="email-access-secondary">Solicitar otro enlace</a>
        }
        else
        {
            <form class="email-access-form" @onsubmit="Recuperar" @onsubmit:preventDefault novalidate>
                <fieldset disabled="@ocupado">
                    <div class="email-access-field">
                        <label for="recovery-email">Correo electrónico</label>
                        <input id="recovery-email" class="form-control" type="email" required maxlength="254" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="tu@correo.com" @bind="correo" @bind:event="oninput" @bind:after="CorreoCambiado" aria-invalid="@(errorCorreo.Length > 0 ? "true" : "false")" aria-describedby="@(errorCorreo.Length > 0 ? "recovery-email-error" : null)" @ref="correoElemento" />
                        @if (errorCorreo.Length > 0) { <p class="email-access-field-error" id="recovery-email-error" role="alert">@errorCorreo</p> }
                    </div>
                    <button type="submit" class="btn btn-primary email-access-submit" disabled="@ocupado">@if (ocupado) { <span class="button-spinner" aria-hidden="true"></span> }@(ocupado ? "Enviando enlace…" : "Enviar enlace de recuperación")</button>
                </fieldset>
            </form>
        }

        @if (Ruta == "recuperar-clave") { <div class="email-access-footer"><span>¿Ya recuerdas tu contraseña?</span><button type="button" @onclick="Iniciar">Iniciar sesión</button></div> }
        @if (Ruta == "restablecer-clave" && EnlaceValido && !confirmada) { <p class="email-access-security"><i class="fas fa-lock" aria-hidden="true"></i>Elige una contraseña que no uses en otras cuentas.</p> }
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? Usuario { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    private string Ruta => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
    private bool EnlaceValido => !string.IsNullOrWhiteSpace(Token) && new EmailAddressAttribute().IsValid(Email ?? "");
    private bool Exito => confirmada || correoEnviado;
    private string Titulo => confirmada ? (Ruta == "confirmar-cuenta" ? "Tu cuenta está lista" : "Contraseña actualizada") : correoEnviado ? "Revisa tu correo" : Ruta == "confirmar-cuenta" ? "Confirma tu cuenta" : Ruta == "restablecer-clave" ? (EnlaceValido ? "Crea una nueva contraseña" : "Necesitas un nuevo enlace") : "Recupera tu acceso";
    private string Descripcion => confirmada ? (Ruta == "confirmar-cuenta" ? "Tu correo está confirmado. Ya puedes reservar tu próxima función." : "Todo listo para volver a CineSpace.") : correoEnviado ? "Sigue el enlace del mensaje para crear una nueva contraseña." : Ruta == "confirmar-cuenta" ? "Estamos verificando el enlace de tu correo." : Ruta == "restablecer-clave" ? (EnlaceValido ? "Protege tu cuenta con una contraseña nueva y segura." : "Abre el enlace completo de tu correo o solicita uno nuevo para continuar.") : "Ingresa el correo de tu cuenta y te enviaremos un enlace para crear una nueva contraseña.";
    private string Icono => Exito ? "fas fa-check" : Ruta == "restablecer-clave" ? "fas fa-key" : "far fa-envelope";
    private bool TieneLongitud => password.Length is >= 10 and <= 128;
    private bool TieneFormato => password.Any(c => c is >= 'A' and <= 'Z') && password.Any(c => c is >= 'a' and <= 'z') && password.Any(c => c is >= '0' and <= '9') && password.Any(c => !char.IsAsciiLetterOrDigit(c));
    private bool PasswordValida => TieneLongitud && TieneFormato;
    private bool MostrarErrorConfirmacion => (confirmarTocada || intentoEnvio) && repetir != password;
    private string correo = "", password = "", repetir = "", mensajeError = "", errorCorreo = "", correoEnviadoA = "";
    private bool ocupado, confirmada, correoEnviado, confirmarTocada, intentoEnvio, enfocarTitulo, enfocarError;
    private string? rutaProcesada;
    private int versionRuta;
    private ElementReference tituloElemento, errorElemento, correoElemento;
    private AuthPasswordField? passwordCampo, confirmacionCampo;

    protected override async Task OnParametersSetAsync()
    {
        if (rutaProcesada == Navigation.Uri) return;
        rutaProcesada = Navigation.Uri; versionRuta++;
        correo = Email ?? ""; password = repetir = mensajeError = errorCorreo = "";
        ocupado = confirmada = correoEnviado = confirmarTocada = intentoEnvio = false;
        if (Ruta == "confirmar-cuenta")
        {
            if (string.IsNullOrWhiteSpace(Usuario) || string.IsNullOrWhiteSpace(Token)) { mensajeError = "Abre el enlace de confirmación que enviamos a tu correo."; return; }
            await Ejecutar(async () => { await Api.Post<ResultadoOperacion>("api/auth/confirmar", new ConfirmarCuenta(Usuario, Token)); return () => confirmada = true; });
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (enfocarTitulo) { enfocarTitulo = false; await tituloElemento.FocusAsync(); }
        if (enfocarError) { enfocarError = false; await errorElemento.FocusAsync(); }
    }
    private async Task Recuperar()
    {
        if (ocupado) return;
        mensajeError = errorCorreo = "";
        correo = correo.Trim();
        if (correo.Length > 254 || !new EmailAddressAttribute().IsValid(correo)) { errorCorreo = "Ingresa un correo electrónico válido, por ejemplo tu@correo.com."; await correoElemento.FocusAsync(); return; }
        await Ejecutar(async () => { await Api.Post<ResultadoOperacion>("api/auth/recuperar", new SolicitudCorreo(correo)); var enviadoA = correo; return () => { correoEnviadoA = enviadoA; correoEnviado = true; }; });
    }
    private async Task Restablecer()
    {
        if (ocupado || !EnlaceValido) return;
        intentoEnvio = true; mensajeError = "";
        if (!PasswordValida) { if (passwordCampo is not null) await passwordCampo.FocusAsync(); return; }
        if (password != repetir) { if (confirmacionCampo is not null) await confirmacionCampo.FocusAsync(); return; }
        await Ejecutar(async () => { await Api.Post<ResultadoOperacion>("api/auth/restablecer", new RestablecerClave(correo, Token!, password)); return () => { password = repetir = ""; confirmada = true; }; });
    }
    private async Task Ejecutar(Func<Task<Action>> accion)
    {
        if (ocupado) return;
        ocupado = true; mensajeError = "";
        var version = versionRuta;
        try { var aplicar = await accion(); if (version == versionRuta) { aplicar(); enfocarTitulo = true; } }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException) { if (version == versionRuta) { mensajeError = ex.Message; enfocarError = true; } }
        finally { if (version == versionRuta) ocupado = false; }
    }
    private void UsarOtroCorreo() { correoEnviado = false; mensajeError = errorCorreo = ""; enfocarTitulo = true; }
    private void CorreoCambiado() { if (errorCorreo.Length > 0 && new EmailAddressAttribute().IsValid(correo.Trim())) errorCorreo = ""; }
    private void Iniciar() { Auth.AbrirDesdeRuta(null); Navigation.NavigateTo("/"); }
}
