@page "/Dashboard"
@implements IAsyncDisposable
@using CineSpace.Client.Components.Admin
@inject TicketSalesService Ventas
@inject UsuarioService Usuarios

<PageTitle>Dashboard - CineSpace</PageTitle>
@if (!Usuarios.EsAdministrador()) { <div class="alert alert-danger" role="alert">El Dashboard está disponible para administradores.</div> }
else
{
    <div class="container cinema-dashboard">
        <div class="management-heading"><div><h1>Dashboard</h1><p>Ventas, ocupación y rendimiento del cine.</p></div><a class="btn btn-secondary" href="/ventas"><i class="fas fa-table-list" aria-hidden="true"></i>Ver resumen de ventas</a></div>
        <section class="dashboard-overview" aria-labelledby="overview-title">
            <div class="overview-heading"><h2 id="overview-title">Ventas de entradas</h2><span>Los filtros se aplican a estos indicadores.</span></div>
            <SalesFilters Id="dashboard" Etiqueta="Filtros de indicadores" Valor="filtro" ValorChanged="CambiarFiltros" GenerosHistoricos="generos.Select(x => x.Nombre)" />
            <dl class="dashboard-metrics" aria-live="polite">
                <div><dt>Tickets vendidos</dt><dd data-metric="tickets">@datos.Tickets.ToString("N0")</dd></div>
                <div><dt>Ingresos de cine</dt><dd data-metric="income">@datos.Ingresos.ToString("N2")<small>Bs</small></dd></div>
                <div><dt>Salas con ventas</dt><dd data-metric="rooms">@datos.Salas</dd></div>
                <div><dt>Ingreso por ticket</dt><dd data-metric="average">@datos.Promedio.ToString("N2")<small>Bs</small></dd></div>
            </dl>
        </section>

        <div class="dashboard-analysis-heading"><div><h2>Rendimiento del cine</h2><p>La ocupación muestra las funciones de hoy en todas las experiencias. Los rankings e ingresos muestran el histórico registrado.</p></div></div>
        <div class="dashboard-charts">
            <section class="dashboard-widget occupancy-widget" aria-labelledby="occupancy-title" aria-busy="@cargandoOcupacion.ToString().ToLowerInvariant()">
                <header class="occupancy-heading">
                    <div><h3 id="occupancy-title">Ocupación de funciones</h3><p>@DiaOcupacion@if(ocupacion.Fecha != default){<span> · @ocupacion.Funciones.ToString("N0") funciones</span>}</p></div>
                    @if(!cargandoOcupacion && errorOcupacion is null){<p class="occupancy-summary"><strong>@ocupacion.Porcentaje.ToString("N1") %</strong><span>de butacas vendidas</span></p>}
                </header>
                @if(cargandoOcupacion){<p class="occupancy-status" role="status">Consultando funciones…</p>}
                else if(errorOcupacion is not null){<div class="occupancy-status" role="alert"><p>@errorOcupacion</p><button type="button" class="btn btn-secondary" @onclick="CargarOcupacion">Reintentar</button></div>}
                else{
                    <AnalyticsChart Tipo="pie" Titulo="Funciones de hoy completas, con disponibilidad y sin ventas" Datos="ocupacion.Estados" Unidad="funciones" MostrarDetalle="true" MostrarPorcentajes="true" Vacio="No hay funciones programadas para hoy." AyudaVacio="La ocupación aparecerá cuando haya funciones en salas activas." />
                }
            </section>
            <section class="dashboard-widget" aria-labelledby="movies-title"><header><h3 id="movies-title">Top 5 películas</h3><p>Histórico · entradas vendidas e ingresos por película</p></header><AnalyticsChart Tipo="horizontal" Titulo="Top 5 películas por entradas vendidas" Datos="datos.PeliculasTop" MostrarDetalle="true" /></section>
            <section class="dashboard-widget" aria-labelledby="hours-title"><header><h3 id="hours-title">Ocupación por horario</h3><p>@DiaOcupacion · todas las experiencias · agrupado por hora</p></header>
                @if(cargandoOcupacion){<p class="occupancy-status" role="status">Consultando horarios…</p>}
                else if(errorOcupacion is not null){<p class="occupancy-status">No se pudieron cargar los horarios de hoy.</p>}
                else{<AnalyticsChart Tipo="vertical" Titulo="Porcentaje de butacas vendidas por horario de hoy" Datos="ocupacion.Horarios" Unidad="%" MaximoEje="100" MostrarDetalle="true" AnchoMinimo="@(ocupacion.Horarios.Count*52)" Vacio="No hay horarios programados para hoy." AyudaVacio="Los horarios aparecerán cuando se programen las funciones." />}
            </section>
            <section class="dashboard-widget" aria-labelledby="genres-title"><header><h3 id="genres-title">Top 5 géneros</h3><p>Tickets por género · una película puede pertenecer a varios</p></header><AnalyticsChart Tipo="vertical" Titulo="Top 5 géneros por tickets" Datos="generos" MostrarDetalle="true" /></section>
            <section class="dashboard-widget" aria-labelledby="rooms-title"><header><h3 id="rooms-title">Salas con más ventas</h3><p>Top 5 · cada compra cuenta como una venta</p></header><AnalyticsChart Tipo="horizontal" Titulo="Top 5 salas por ventas" Datos="salas" Unidad="ventas" MostrarDetalle="true" /></section>
            <section class="dashboard-widget" aria-labelledby="experiences-title"><header><h3 id="experiences-title">Experiencias con más ventas</h3><p>Top 5 · consulta también los tickets de cada experiencia</p></header><AnalyticsChart Tipo="horizontal" Titulo="Top experiencias por ventas" Datos="experiencias" Unidad="ventas" MostrarDetalle="true" /></section>
            <section class="dashboard-widget" aria-labelledby="confection-title"><header><h3 id="confection-title">Top 5 categorías de confitería</h3><p>Participación en ingresos de las categorías más vendidas</p></header><AnalyticsChart Tipo="donut" Titulo="Top 5 categorías de confitería por ingresos" Datos="categorias" Unidad="Bs" Vacio="Sin ventas de confitería registradas." /></section>
            <section class="dashboard-widget" aria-labelledby="daily-title"><header><h3 id="daily-title">Ingresos de los últimos 5 días</h3><p>Cine y confitería · incluye hoy</p></header><AnalyticsChart Tipo="grouped" Titulo="Comparación de ingresos de cine y confitería en cinco días" Series="ingresosCinco" Etiquetas="etiquetasCinco" Unidad="Bs" Vacio="No hay ingresos registrados en estos cinco días." /></section>
            <section class="dashboard-widget dashboard-widget-wide" aria-labelledby="trend-title"><header><h3 id="trend-title">Evolución de ingresos</h3><p>Últimos 30 días · detecta días fuertes y compara cine, confitería y total</p></header><AnalyticsChart Tipo="line" Titulo="Evolución diaria de ingresos durante treinta días" Series="ingresosMes" Etiquetas="etiquetasMes" Unidad="Bs" Vacio="No hay ingresos registrados en estos treinta días." /></section>
        </div>
    </div>
}
@code {
    private AnaliticaCine datos = new();
    private FiltroVentas filtro = new();
    private OcupacionDashboard ocupacion = new();
    private int versionOcupacion;
    private readonly CancellationTokenSource cancelacion = new();
    private Task? cambioDia;
    private string DiaOcupacion => ocupacion.Fecha == default ? "Hoy" : $"Hoy, {ocupacion.Fecha:dd/MM/yyyy}";
    private bool cargandoOcupacion;
    private string? errorOcupacion;
    private IReadOnlyList<DatoGrafico> generos => datos.Generos;
    private IReadOnlyList<DatoGrafico> salas => datos.SalasTop;
    private IReadOnlyList<DatoGrafico> experiencias => datos.Experiencias;
    private IReadOnlyList<DatoGrafico> categorias => datos.Categorias;
    private IReadOnlyList<SerieGrafico> ingresosCinco => datos.IngresosCinco;
    private IReadOnlyList<SerieGrafico> ingresosMes => datos.IngresosMes;
    private IReadOnlyList<string> etiquetasCinco => datos.EtiquetasCinco;
    private IReadOnlyList<string> etiquetasMes => datos.EtiquetasMes;
    protected override async Task OnInitializedAsync()
    {
        if (!Usuarios.EsAdministrador()) return;
        await Task.WhenAll(CambiarFiltros(filtro), CargarOcupacion());
        if (!cancelacion.IsCancellationRequested) cambioDia = ActualizarAlCambiarDia(cancelacion.Token);
    }
    private async Task CargarOcupacion()
    {
        var version = ++versionOcupacion;
        cargandoOcupacion = true; errorOcupacion = null;
        try
        {
            var resultado = await Ventas.OcupacionHoyAsync(cancelacion.Token);
            if (version != versionOcupacion) return;
            ocupacion = resultado;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (InvalidOperationException ex) { if (version == versionOcupacion) errorOcupacion = ex.Message; }
        finally { if (version == versionOcupacion) cargandoOcupacion = false; }
    }
    private async Task ActualizarAlCambiarDia(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                var espera = ocupacion.CambioDiaUtc - DateTime.UtcNow;
                await Task.Delay(espera > TimeSpan.Zero ? espera : TimeSpan.FromMinutes(1), ct);
                await InvokeAsync(async () => { await CargarOcupacion(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        await cancelacion.CancelAsync();
        if (cambioDia is not null) await cambioDia;
        cancelacion.Dispose();
    }
    private int versionCarga;
    private async Task CambiarFiltros(FiltroVentas valor) { var version=++versionCarga; filtro=valor; var resultado=await Ventas.AnaliticaAsync(valor); if(version==versionCarga) datos=resultado; }
}
