@inject ApiCine Api
@page "/admin/categorias-confiteria"
@page "/admin/generos"
@using CineSpace.Client.Components.Admin
@using CineSpace.Client.Components.Shared
@inject CatalogosService Catalogos
@inject PeliculaService Peliculas
@inject UsuarioService Usuarios
@inject NavigationManager Navigation

<PageTitle>@Titulo - CineSpace</PageTitle>
@if (!Usuarios.EsAdministrador()) { <div class="alert alert-danger" role="alert">Esta sección está disponible para administradores.</div> }
else
{
    <div class="movie-management">
    <div class="management-heading"><div><h1>@Titulo</h1><p>@(EsGenero ? "Organiza los géneros que se utilizan en películas y filtros de cartelera." : "Organiza los combos que se muestran en la confitería.")</p></div><button type="button" class="btn btn-primary" @onclick="Crear"><i class="fas fa-plus" aria-hidden="true"></i>@(EsGenero ? "Crear género" : "Crear categoría")</button></div>
    @if (!string.IsNullOrEmpty(aviso)) { <div class="alert alert-success" role="status">@aviso</div> }
    @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (!string.IsNullOrEmpty(Catalogos.ErrorCarga)) { <div class="alert alert-warning" role="alert">@Catalogos.ErrorCarga</div> }
    @if (editando != null)
    {
        <form class="catalogue-name-editor" @onsubmit="Guardar" @onsubmit:preventDefault aria-label="@(editando.Id == 0 ? "Crear registro" : "Editar registro")"><div><label for="taxonomy-name">@(EsGenero ? "Nombre del género" : "Nombre de la categoría")</label><input id="taxonomy-name" class="form-control" maxlength="60" placeholder="@(EsGenero ? "Ej. Cine independiente" : "Ej. Para dos")" @bind="editando.Nombre" @bind:event="oninput" @ref="nombreInput" disabled="@guardando" /></div><button type="button" class="btn btn-secondary" @onclick="Cancelar" disabled="@guardando">Cancelar</button><button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando…" : "Guardar")</button></form>
    }
    <div class="catalogue-toolbar movie-management-toolbar"><form class="catalogue-search @(busqueda.Length > 0 || filtro.Length > 0 ? "has-query" : "")" role="search" @onsubmit="Buscar" @onsubmit:preventDefault><label class="visually-hidden" for="taxonomy-search">Buscar por nombre</label><input id="taxonomy-search" class="form-control" type="search" placeholder="Buscar por nombre…" @bind="busqueda" @bind:event="oninput" />@if (busqueda.Length > 0 || filtro.Length > 0) { <button type="button" class="catalogue-clear" aria-label="Limpiar búsqueda" @onclick="Limpiar"><i class="fas fa-times" aria-hidden="true"></i></button> }<button type="submit" class="btn btn-primary" aria-label="Buscar registros"><i class="fas fa-search" aria-hidden="true"></i></button></form><div class="catalogue-secondary-filters"><CompactOrder Id="taxonomy-order" Valor="@orden" ValorChanged="CambiarOrden" /><ClearFiltersButton Activo="@(!string.IsNullOrWhiteSpace(filtro))" OnClear="Limpiar" /></div></div>
    @if (Filtradas.Count == 0) { <div class="catalogue-empty" role="status"><h2>@(string.IsNullOrEmpty(filtro) ? "Aún no hay registros" : "No encontramos coincidencias")</h2><p>@(string.IsNullOrEmpty(filtro) ? "Crea el primero para comenzar a organizar el catálogo." : "Prueba otro nombre o limpia la búsqueda.")</p></div> }
    else
    {
        <ManagementTable Title="@(EsGenero ? "Géneros" : "Categorías")" Summary="@($"{Filtradas.Count} {(EsGenero ? "géneros" : "categorías")}")" TableClass="taxonomy-table"><HeaderContent><tr><th scope="col">Nombre</th><th scope="col">@(EsGenero ? "Películas en cartelera" : "Combos")</th><th scope="col">Acciones</th></tr></HeaderContent><ChildContent>
            @foreach (var etiqueta in Filtradas)
            {
                <tr @key="etiqueta.Id" data-taxonomy-id="@etiqueta.Id"><td><strong>@etiqueta.Nombre</strong></td><td>@Uso(etiqueta)</td><td><div class="managed-table-actions"><button type="button" class="btn btn-secondary" aria-label="Editar @etiqueta.Nombre" title="Editar" @onclick="() => Editar(etiqueta)"><i class="fas fa-pen-to-square" aria-hidden="true"></i></button><button type="button" class="btn btn-danger" aria-label="Eliminar @etiqueta.Nombre" title="@(Protegida(etiqueta) ? EsGenero ? "Género del catálogo o asignado a películas" : "Categoría con combos" : "Eliminar")" disabled="@Protegida(etiqueta)" @onclick="() => SolicitarEliminar(etiqueta)"><i class="fas fa-trash" aria-hidden="true"></i></button></div></td></tr>
            }
        </ChildContent></ManagementTable>
        <Pagination CurrentPage="pagina" TotalPages="TotalPaginas" TotalItems="totalItems" PageSize="PorPagina" ShowPageSizeSelector="false" Label="Paginación del catálogo" OnPageChanged="CambiarPaginaRemota" />
    }
    </div>
}
@if (eliminar != null)
{
    <AppDialog Title="@(EsGenero ? "¿Eliminar este género?" : "¿Eliminar esta categoría?")" OnClose="CerrarEliminar" @ref="confirmacion"><ChildContent><p>Se eliminará <strong>@eliminar.Nombre</strong> del catálogo.</p></ChildContent><Footer><button type="button" class="btn btn-secondary" @onclick="CancelarEliminar" disabled="@guardando">Cancelar</button><button type="button" class="btn btn-danger" @onclick="Eliminar" disabled="@guardando">Eliminar</button></Footer></AppDialog>
}
@code {
    private async Task CambiarPaginaRemota(int valor) { pagina = valor; await CargarPagina(); }
    private async Task CargarPagina() {
        try {
            var f = new ConsultaPagina { Pagina = pagina, Tamano = PorPagina, Buscar = filtro, Orden = orden == "Más recientes" ? "recientes" : "antiguas" };
            var page = await Catalogos.ConsultarEtiquetasAsync(EsGenero,f);
            Filtradas = page.Items; totalItems = page.Total; pagina = page.Numero;
        } catch (Exception ex) { error = ex.Message; }
    }

    private bool EsGenero => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/') == "admin/generos";
    private string Titulo => EsGenero ? "Géneros de cartelera" : "Categorías de confitería";
    private bool? modoAnterior;
    private const int PorPagina = 8;
    private int pagina = 1;
    private string busqueda = "", filtro = "", orden = "Más recientes", error = "", aviso = "";
    private bool guardando, enfocar;
    private EtiquetaCatalogo? editando, eliminar;
    private List<Pelicula> peliculas = new();
    private AppDialog? confirmacion;
    private ElementReference nombreInput;
    private List<EtiquetaCatalogo> Filtradas = [];
    private int totalItems;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(totalItems / (double)PorPagina));
    private int Uso(EtiquetaCatalogo etiqueta) => EsGenero ? Api.Referencias.UsosGeneros.GetValueOrDefault(etiqueta.Id) : Catalogos.UsoCategoria(etiqueta.Id);
    private bool Protegida(EtiquetaCatalogo etiqueta) => Uso(etiqueta) > 0 || EsGenero && etiqueta.Sistema;
    protected override async Task OnParametersSetAsync() { if (modoAnterior == EsGenero) return; modoAnterior = EsGenero; editando = eliminar = null; busqueda = filtro = aviso = error = ""; pagina = 1; orden = "Más recientes"; if (Usuarios.EsAdministrador()) await CargarPagina(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (enfocar && editando != null) { enfocar = false; await nombreInput.FocusAsync(); } }
    private void Crear() { editando = new(); enfocar = true; error = aviso = ""; }
    private void Editar(EtiquetaCatalogo etiqueta) { editando = etiqueta.Copiar(); enfocar = true; error = aviso = ""; }
    private void Cancelar() { editando = null; error = ""; }
    private async Task Guardar() { if (editando == null || guardando) return; guardando = true; error = ""; try { var id = await Catalogos.GuardarEtiquetaAsync(EsGenero, editando); aviso = $"{editando.Nombre.Trim()} guardado correctamente."; editando = null; busqueda = filtro = ""; pagina = 1; await CargarPagina(); } catch (ArgumentException ex) { error = ex.Message; } catch { error = "No pudimos guardar el registro. Inténtalo de nuevo; tus cambios siguen aquí."; } finally { guardando = false; } }
    private void SolicitarEliminar(EtiquetaCatalogo etiqueta) { eliminar = etiqueta; error = aviso = ""; }
    private void CerrarEliminar() => eliminar = null;
    private Task CancelarEliminar() => confirmacion?.CerrarDialogo() ?? Task.CompletedTask;
    private async Task Eliminar() { if (eliminar == null || guardando) return; var etiqueta = eliminar; guardando = true; try { await Catalogos.EliminarEtiquetaAsync(EsGenero, etiqueta.Id, Uso(etiqueta) > 0); await CancelarEliminar(); await CargarPagina(); aviso = $"{etiqueta.Nombre} eliminado del catálogo."; } catch (ArgumentException ex) { await CancelarEliminar(); error = ex.Message; } catch { await CancelarEliminar(); error = "No pudimos eliminar el registro. Inténtalo de nuevo."; } finally { guardando = false; } }
    private async Task Buscar() { filtro = busqueda.Trim(); pagina = 1;  await CargarPagina(); }
    private async Task Limpiar() { busqueda = filtro = ""; pagina = 1;  await CargarPagina(); }
    private async Task CambiarOrden(string valor) { orden = valor; pagina = 1;  await CargarPagina(); }
}
