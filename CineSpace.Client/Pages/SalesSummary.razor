@page "/ventas"
@implements IDisposable
@using CineSpace.Client.Components.Admin
@inject TicketSalesService Ventas
@inject UsuarioService Usuarios

<PageTitle>Resumen de ventas - CineSpace</PageTitle>
@if (!Usuarios.EsAdministrador()) { <div class="alert alert-danger" role="alert">El resumen de ventas está disponible para administradores.</div> }
else
{
    <div class="container report-page">
        <div class="management-heading"><div><h1>Resumen de ventas</h1><p>Consulta el detalle de las entradas vendidas.</p></div><a class="btn btn-secondary" href="/Dashboard"><i class="fas fa-chart-line" aria-hidden="true"></i>Ver Dashboard</a></div>
        <section class="sales-summary-panel" aria-label="Ventas de entradas" aria-busy="@cargando.ToString().ToLowerInvariant()" data-request-feedback="managed">
            <SalesFilters Id="summary" Valor="filtro" ValorChanged="CambiarFiltros" PeriodoInicial="todos" GenerosHistoricos="ventas.SelectMany(v => v.Generos)" />
            @if (error is not null) { <div class="alert alert-danger mt-3" role="alert"><p>@error</p><button type="button" class="btn btn-secondary" @onclick="Reintentar">Reintentar</button></div> }
            @if (cargando) { <p class="sales-summary-status" role="status">Cargando ventas…</p> }
            @if (error is null && ventas.Count > 0)
            {
                <div class="table-responsive sales-table-scroll"><table class="table table-striped table-hover"><thead><tr><th scope="col">Fecha</th><th scope="col">Película</th><th scope="col">Género</th><th scope="col">Sala</th><th scope="col">Tipo de sala</th><th scope="col">Experiencia</th><th scope="col">Tickets mayores</th><th scope="col">Tickets menores</th><th scope="col">Total tickets</th><th scope="col">Total (Bs)</th></tr></thead><tbody>
                @foreach (var venta in ventas) { <tr @key="venta.Id"><td>@venta.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td><td>@venta.Pelicula</td><td>@venta.GenerosTexto</td><td>@venta.NumeroSala</td><td>@venta.TipoSalaNombre</td><td>@venta.ExperienciaNombre</td><td>@venta.TicketsMayores</td><td>@venta.TicketsMenores</td><td>@venta.CantidadTickets</td><td>@venta.TotalVenta.ToString("N2") Bs</td></tr> }
                </tbody><tfoot><tr><th colspan="6" scope="row">Totales filtrados</th><td>@resumen.TicketsMayores</td><td>@resumen.TicketsMenores</td><td>@resumen.Tickets</td><td>@resumen.Ingresos.ToString("N2") Bs</td></tr></tfoot></table></div>
            }
            else if (!cargando && error is null) { <div class="sales-summary-empty" role="status">No hay ventas registradas con estos filtros.</div> }
            <Pagination CurrentPage="pagina" TotalPages="TotalPaginas" TotalItems="totalItems" PageSize="PorPagina" ShowPageSizeSelector="false" Label="Paginación de ventas" Disabled="@(cargando || error is not null)" OnPageChanged="CambiarPagina" />
        </section>
    </div>
}
@code {
    private List<FilaResumenVenta> ventas = [];
    private FiltroVentas filtro = new("todos");
    private TotalesResumenVentas resumen = TotalesResumenVentas.Vacio;
    private const int PorPagina = 10;
    private int pagina = 1, solicitada = 1, totalItems, versionCarga;
    private bool cargando;
    private string? error;
    private CancellationTokenSource? carga;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(totalItems / (double)PorPagina));
    protected override async Task OnInitializedAsync() { if (Usuarios.EsAdministrador()) await Cargar(1); }
    private Task CambiarFiltros(FiltroVentas valor) { filtro = valor; return Cargar(1); }
    private Task CambiarPagina(int valor) => Cargar(valor);
    private Task Reintentar() => Cargar(solicitada);
    private async Task Cargar(int numero)
    {
        var version = ++versionCarga;
        carga?.Cancel();
        var actual = new CancellationTokenSource(); carga = actual;
        solicitada = numero; cargando = true; error = null;
        try
        {
            var resultado = await Ventas.ResumenVentasAsync(filtro, numero, actual.Token);
            if (version != versionCarga) return;
            ventas = resultado.Pagina.Items; totalItems = resultado.Pagina.Total;
            pagina = resultado.Pagina.Numero; resumen = resultado.Totales;
        }
        catch (OperationCanceledException) when (actual.IsCancellationRequested) { }
        catch (InvalidOperationException ex) { if (version == versionCarga) error = ex.Message; }
        finally
        {
            if (version == versionCarga) { cargando = false; carga = null; }
            actual.Dispose();
        }
    }
    public void Dispose() { ++versionCarga; carga?.Cancel(); }
}
