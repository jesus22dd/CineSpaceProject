@page "/ventas"
@using CineSpace.Client.Components.Admin
@inject TicketSalesService Ventas
@inject UsuarioService Usuarios

<PageTitle>Resumen de ventas - CineSpace</PageTitle>
@if (!Usuarios.EsAdministrador()) { <div class="alert alert-danger" role="alert">El resumen de ventas está disponible para administradores.</div> }
else
{
    <div class="container report-page">
        <div class="management-heading"><div><h1>Resumen de ventas</h1><p>Consulta el detalle de las entradas vendidas.</p></div><a class="btn btn-secondary" href="/Dashboard"><i class="fas fa-chart-line" aria-hidden="true"></i>Ver Dashboard</a></div>
        <section class="sales-summary-panel" aria-label="Ventas de entradas">
            <SalesFilters Id="summary" Valor="filtro" ValorChanged="CambiarFiltros" PeriodoInicial="todos" GenerosHistoricos="ventas.SelectMany(v => v.ListaGeneros)" />
            @if (filtradas.Count == 0) { <div class="sales-summary-empty" role="status">No hay ventas registradas con estos filtros.</div> }
            else
            {
                <div class="table-responsive sales-table-scroll"><table class="table table-striped table-hover"><thead><tr><th scope="col">Fecha</th><th scope="col">Película</th><th scope="col">Género</th><th scope="col">Sala</th><th scope="col">Tipo de sala</th><th scope="col">Experiencia</th><th scope="col">Tickets mayores</th><th scope="col">Tickets menores</th><th scope="col">Total tickets</th><th scope="col">Total (Bs)</th></tr></thead><tbody>
                @foreach (var venta in Paginadas) { <tr><td>@venta.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td><td>@venta.Pelicula</td><td>@venta.GenerosTexto</td><td>@venta.NumeroSala</td><td>@AnaliticaVentas.NombreTipoSala(venta)</td><td>@AnaliticaVentas.NombreExperiencia(venta)</td><td>@venta.TicketsMayores</td><td>@venta.TicketsMenores</td><td>@venta.CantidadTickets</td><td>@venta.TotalVenta.ToString("N2") Bs</td></tr> }
                </tbody><tfoot><tr><th colspan="6" scope="row">Totales filtrados</th><td>@resumen.Tickets</td><td>0</td><td>@resumen.Tickets</td><td>@resumen.Ingresos.ToString("N2") Bs</td></tr></tfoot></table></div>
            }
            <Pagination CurrentPage="pagina" TotalPages="TotalPaginas" TotalItems="totalItems" PageSize="PorPagina" ShowPageSizeSelector="false" Label="Paginación de ventas" OnPageChanged="CambiarPagina" />
        </section>
    </div>
}
@code {
    private List<VentaTicket> ventas = [], filtradas = [];
    private FiltroVentas filtro = new("todos");
    private AnaliticaCine resumen = new();
    private const int PorPagina = 10;
    private int pagina = 1, totalItems;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(totalItems / 10d));
    private IEnumerable<VentaTicket> Paginadas => filtradas;
    protected override async Task OnInitializedAsync() { if (Usuarios.EsAdministrador()) await CambiarFiltros(filtro); }
    private async Task CambiarFiltros(FiltroVentas valor) { filtro = valor; pagina = 1; resumen = await Ventas.AnaliticaAsync(filtro); await Cargar(); }
    private async Task Cargar() { var p = await Ventas.ResumenVentasAsync(filtro,pagina); ventas = filtradas = p.Items; totalItems = p.Total; pagina = p.Numero; }
    private async Task CambiarPagina(int valor) { pagina = valor; await Cargar(); }
}
