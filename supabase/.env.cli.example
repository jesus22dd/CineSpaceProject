# Copia este archivo a .env.cli.local y completa los valores en privado.
# ID remoto de 20 letras, desde Project Settings > General (no "CineSpaceFS").
SUPABASE_PROJECT_REF=
# Personal access token limitado al proyecto del cine.
SUPABASE_ACCESS_TOKEN=
# Contrasena de PostgreSQL, no la contrasena de tu cuenta de Supabase.
SUPABASE_DB_PASSWORD=
# Los valores son literales. No se expanden $, %, ! ni se interpretan escapes.
# Se aceptan comillas externas dobles o simples; no anadas comentarios al final.
